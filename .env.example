# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Transactional email (notifications, password reset, email verification).
# Any SMTP provider works — Gmail, Amazon SES, Mailgun, etc.
# Gmail: host=smtp.gmail.com port=465, user=your@gmail.com, pass=an App Password
# (https://myaccount.google.com/apppasswords). Leave SMTP_HOST blank to disable
# email locally: notifications are logged + skipped, and verification/reset links
# are printed to the dev server console so you can still complete the flow.
# REQUIRED IN PRODUCTION — without it nobody can verify their email or reset a
# password, and the app now reports that as an error instead of silently
# pretending the mail was sent.
SMTP_HOST=""
SMTP_PORT="587"          # 465 for implicit TLS, 587 for STARTTLS
SMTP_SECURE=""           # set to "1" to force TLS (auto-on for port 465)
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Sunday League <noreply@yourdomain.com>"

# Admin bootstrap — comma-separated emails get isAdmin=true on first login
ADMIN_EMAILS="you@example.com"

# App — the public base URL. Every link we put in an email is built from this,
# so if it's wrong in production the emails arrive with dead links. Falls back to
# NEXTAUTH_URL, then the Vercel deployment URL, then localhost.
APP_URL="http://localhost:3000"
DEFAULT_TZ="Europe/London"

# Web Push (PWA notifications) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
